{
  "name": "repbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21 || >=22.12 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "npm run sync:contracts && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "node scripts/sync-contracts.mjs && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --project demo-repbook --only firestore 'vitest run --config vitest.emulator.config.ts'",
    "emulators": "firebase emulators:start --project demo-repbook --only auth,firestore",
    "test:e2e": "playwright test",
    "test:integration": "firebase emulators:exec --project demo-repbook --only auth,firestore 'playwright test'",
    "sync:contracts": "node scripts/sync-contracts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lucide/svelte": "1.51.0",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "ajv": "8.20.0",
    "firebase": "12.19.0",
    "idb-keyval": "6.3.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.0",
    "firebase-tools": "15.32.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  }
}
